value="atiende" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c7" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c107" value="genera" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c63" target="c72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c108" value="recibe" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c7" target="c72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c109" value="escribe" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c63" target="c87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c110" value="registra" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c7" target="c87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c111" value="atiende (asignado_a)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c29" target="c72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c112" value="agrupa" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c72" target="c87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c113" value="escribe (humano)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeColor=#5d6a62;fontSize=11;" edge="1" parent="1" source="c29" target="c87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c114" value="&lt;b&gt;atenciones&lt;/b&gt; = cada vez que el bot pasa un cliente a una persona.&lt;br&gt;Ahí queda el motivo, el resumen, los datos del interés,&lt;br&gt;quién lo atiende y el monto si se vendió." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff4e6;strokeColor=#b4621d;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="330" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Actores"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Cliente final" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fontStyle=1;strokeColor=#1f7a55;fillColor=#e3f1ea;" vertex="1" parent="1"><mxGeometry x="140" y="40" width="40" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Escribe por Telegram (MVP) o WhatsApp. Curiosea, pregunta precios o quiere comprar." style="rounded=1;whiteSpace=wrap;fillColor=#e3f1ea;strokeColor=#1f7a55;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Dueño del negocio" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fontStyle=1;strokeColor=#1f7a55;fillColor=#e3f1ea;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="40" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Mantiene el catálogo y los datos del negocio. Atiende a los clientes que el bot le pasa." style="rounded=1;whiteSpace=wrap;fillColor=#e3f1ea;strokeColor=#1f7a55;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Empleado" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fontStyle=1;strokeColor=#1f7a55;fillColor=#e3f1ea;" vertex="1" parent="1"><mxGeometry x="720" y="40" width="40" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Atiende la lista &#x27;Por atender&#x27;: concreta la venta, verifica el pago y la marca vendida." style="rounded=1;whiteSpace=wrap;fillColor=#e3f1ea;strokeColor=#1f7a55;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="240" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fontStyle=1;strokeColor=#1f7a55;fillColor=#e3f1ea;" vertex="1" parent="1"><mxGeometry x="1010" y="40" width="40" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Crea negocios, configura el agente de cada uno, plantillas y suscripciones." style="rounded=1;whiteSpace=wrap;fillColor=#e3f1ea;strokeColor=#1f7a55;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="240" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Agente IA (n8n)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Atiende, busca en el catálogo y, en un momento importante, deja un último mensaje, se pausa y pasa el cliente a una persona." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#b4621d;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="340" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Tareas programadas (Laravel)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vuelven a avisar si un cliente lleva mucho tiempo sin ser atendido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#b4621d;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="280" width="340" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Servicios externos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Telegram, WhatsApp Business API, Gemini y Cloudinary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f